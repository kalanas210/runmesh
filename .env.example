# RunMesh configuration.
#
# Every value below is also the built-in default, EXCEPT RUNMESH_API_KEYS,
# which has none: starting unauthenticated must not be something a forgotten
# variable can cause.
#
# Everything is validated at boot, and every problem is reported at once — an
# operator fixing a misconfigured deployment should not have to restart the
# process once per mistake.

# ─── Auth ────────────────────────────────────────────────────────────────────
# Comma-separated `id[:scope+scope]=key` entries. The id is for log correlation
# and revocation; it is never a credential. Keys must be at least 16 characters.
#   generate one with:  openssl rand -hex 32
#
# Scopes:
#   jobs.read     GET /jobs, /jobs/{id}, /jobs/{id}/events, /tools
#   jobs.write    POST /jobs
#   jobs.cancel   POST /jobs/{id}/cancel
#   admin         implies every scope, including ones added later
#
# A key with NO scope list is granted everything, so `dev=<key>` from Week 1
# still works — and the server names every such key in a warning at boot,
# because a permissive default is only defensible if it cannot be held by
# accident. Least privilege looks like this:
#
#   RUNMESH_API_KEYS=dash:jobs.read=<k1>,planner:jobs.read+jobs.write=<k2>,ops:admin=<k3>
#
# Note that jobs.cancel is separate from jobs.write on purpose: submitting work
# and stopping somebody else's are different authorities, and an agent in a
# retry loop should not be able to halt the fleet.
RUNMESH_API_KEYS=dev=0123456789abcdef0123456789abcdef

# ─── HTTP ────────────────────────────────────────────────────────────────────
RUNMESH_HTTP_ADDR=:8080
RUNMESH_READ_HEADER_TIMEOUT=5s
RUNMESH_READ_TIMEOUT=15s
RUNMESH_WRITE_TIMEOUT=30s
RUNMESH_IDLE_TIMEOUT=60s
RUNMESH_MAX_REQUEST_BYTES=1048576

# ─── Shutdown, in the order the phases run ───────────────────────────────────
# 1. stop accepting, let in-flight requests finish
RUNMESH_SHUTDOWN_GRACE=10s
# 2. let in-flight steps finish; after this they are RELEASED back to QUEUED
#    with their retry budget untouched — a deploy must cost zero retries
RUNMESH_DRAIN_TIMEOUT=30s
# 3. the backstop. Must exceed SHUTDOWN_GRACE + DRAIN_TIMEOUT, or it would
#    abort a shutdown that was going to succeed
RUNMESH_HARD_EXIT_AFTER=60s

# ─── Engine ──────────────────────────────────────────────────────────────────
# Names this process in the leases it takes. Defaults to hostname-pid.
# RUNMESH_OWNER=

RUNMESH_WORKERS=8
# How many steps to claim per round trip. Defaults to RUNMESH_WORKERS; it can
# never exceed it, because the dispatcher only claims what it has capacity for.
# RUNMESH_CLAIM_BATCH=

# The backstop for the store's wake-up hint. Losing a hint costs one tick of
# latency; it can never strand a job.
RUNMESH_POLL_INTERVAL=250ms

# A lease is the capability a worker holds over one step. If it expires, the
# reconciler assumes that worker died and reclaims the step.
RUNMESH_LEASE_TTL=30s
# Must leave at least three beats per lease, so two can be lost to a slow store
# or a GC pause without expiring a lease under a step that is running fine.
RUNMESH_HEARTBEAT_INTERVAL=5s
# How long a single store call may take. Must be shorter than the drain it is
# part of.
RUNMESH_STORE_TIMEOUT=5s
# How long to wait for a tool that is ignoring its cancellation before settling
# the step without it. Must be shorter than the lease it is protecting.
RUNMESH_ABANDON_GRACE=10s

# The crash-recovery sweep.
RUNMESH_RECONCILE_INTERVAL=10s
RUNMESH_RECONCILE_BATCH=100

# ─── Retry ───────────────────────────────────────────────────────────────────
# delay = BASE * FACTOR^failures, capped at MAX, then reduced by up to JITTER.
# Jitter only ever subtracts, so MAX is a real ceiling rather than an average.
RUNMESH_BACKOFF_BASE=1s
RUNMESH_BACKOFF_MAX=60s
RUNMESH_BACKOFF_FACTOR=2.0
RUNMESH_BACKOFF_JITTER=0.2

# ─── Admission control and plan limits ───────────────────────────────────────
# Submissions past this depth are refused with 429 rather than accepted into a
# queue that will never drain.
RUNMESH_MAX_QUEUE_DEPTH=10000

RUNMESH_MAX_STEPS=100
RUNMESH_MAX_DEPENDS_ON=32
RUNMESH_MAX_PARAMS_BYTES=65536
RUNMESH_MAX_STEP_TIMEOUT=15m
RUNMESH_MAX_ATTEMPTS_LIMIT=10
RUNMESH_MAX_RESULT_BYTES=262144

# Defaults applied to a step that does not specify its own.
RUNMESH_STEP_TIMEOUT=30s
RUNMESH_MAX_ATTEMPTS=3

# ─── Store ───────────────────────────────────────────────────────────────────
# The ONLY thing that selects the store. Empty means the in-memory store, which
# is a development convenience and not a deployment option: a restart loses
# every job, GET /ready reports "durable": false, and the server says so at boot.
#
# A URL that is set but unreachable FAILS the boot. It never falls back to the
# in-memory store — silently starting non-durable is how an outage becomes data
# loss.
#
#   docker compose up -d
#   RUNMESH_DATABASE_URL=postgres://runmesh:runmesh@127.0.0.1:5432/runmesh?sslmode=disable
RUNMESH_DATABASE_URL=

# Migrations are embedded in the binary and applied at boot under an advisory
# lock, so a rolling deploy of five replicas runs them exactly once. Turn this
# off to run them as a separate deployment step instead.
RUNMESH_MIGRATE_ON_BOOT=true

# Defaults to RUNMESH_WORKERS + 4, and may not be set lower. Every worker can be
# holding a connection to settle its outcome while the dispatcher, the
# reconciler and a readiness probe still need one; a pool sized to the worker
# count alone can deadlock its own drain.
# RUNMESH_DB_MAX_OPEN_CONNS=
# RUNMESH_DB_MAX_IDLE_CONNS=
RUNMESH_DB_CONN_MAX_LIFETIME=30m
RUNMESH_DB_CONN_MAX_IDLE_TIME=5m
RUNMESH_DB_CONNECT_TIMEOUT=10s

# In-memory store only: the timeline has to be bounded, or a long-running job is
# a memory leak. Exceeding a ring marks the page `truncated` rather than failing
# the job. PostgreSQL has no such limit and ignores both.
RUNMESH_JOB_EVENT_BUFFER=512
RUNMESH_GLOBAL_EVENT_BUFFER=8192

# ─── Tools ───────────────────────────────────────────────────────────────────
# Registers the `fail` tool, whose entire purpose is to panic, hang and fail on
# demand. Off by default; a production deployment must not expose it.
RUNMESH_ENABLE_TEST_TOOLS=false
RUNMESH_MAX_OUTPUT_BYTES=65536

# ─── Logging ─────────────────────────────────────────────────────────────────
# debug | info | warn | error
RUNMESH_LOG_LEVEL=info
# json | text  (text is easier to read locally; json is what you want shipped)
RUNMESH_LOG_FORMAT=json
