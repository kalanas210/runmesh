# RunMesh configuration (see internal/config).
# Copy to .env for local use. Every value below is also the built-in default,
# except RUNMESH_API_KEYS, which has no default and must be set.

# HTTP server
RUNMESH_HTTP_ADDR=:8080
RUNMESH_READ_HEADER_TIMEOUT=5s
RUNMESH_SHUTDOWN_TIMEOUT=20s

# Auth: comma-separated API keys accepted on the X-API-Key header.
# Generate one with:  openssl rand -hex 32
RUNMESH_API_KEYS=dev-local-key

# Worker pool
RUNMESH_WORKERS=8
RUNMESH_QUEUE_CAPACITY=1024
RUNMESH_STEP_TIMEOUT=30s
RUNMESH_MAX_ATTEMPTS=3
RUNMESH_RETRY_BASE_DELAY=1s
RUNMESH_RETRY_MAX_DELAY=30s

# Logging: debug | info | warn | error
RUNMESH_LOG_LEVEL=info
