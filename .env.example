# RunMesh configuration.
#
# Every value below is also the built-in default, EXCEPT RUNMESH_API_KEYS,
# which has none: starting unauthenticated must not be something a forgotten
# variable can cause.
#
# Everything is validated at boot, and every problem is reported at once — an
# operator fixing a misconfigured deployment should not have to restart the
# process once per mistake.

# ─── Auth ────────────────────────────────────────────────────────────────────
# Comma-separated `id[:scope+scope]=key` entries. The id is for log correlation
# and revocation; it is never a credential. Keys must be at least 16 characters.
#   generate one with:  openssl rand -hex 32
#
# Scopes:
#   jobs.read     GET /jobs, /jobs/{id}, /jobs/{id}/events, /tools
#   jobs.write    POST /jobs
#   jobs.cancel   POST /jobs/{id}/cancel
#   admin         implies every scope, including ones added later
#
# A key with NO scope list is granted everything, so `dev=<key>` from Week 1
# still works — and the server names every such key in a warning at boot,
# because a permissive default is only defensible if it cannot be held by
# accident. Least privilege looks like this:
#
#   RUNMESH_API_KEYS=dash:jobs.read=<k1>,planner:jobs.read+jobs.write=<k2>,ops:admin=<k3>
#
# Note that jobs.cancel is separate from jobs.write on purpose: submitting work
# and stopping somebody else's are different authorities, and an agent in a
# retry loop should not be able to halt the fleet.
RUNMESH_API_KEYS=dev=0123456789abcdef0123456789abcdef

# ─── HTTP ────────────────────────────────────────────────────────────────────
RUNMESH_HTTP_ADDR=:8080
RUNMESH_READ_HEADER_TIMEOUT=5s
RUNMESH_READ_TIMEOUT=15s
RUNMESH_WRITE_TIMEOUT=30s
RUNMESH_IDLE_TIMEOUT=60s
RUNMESH_MAX_REQUEST_BYTES=1048576

# ─── Shutdown, in the order the phases run ───────────────────────────────────
# 1. stop accepting, let in-flight requests finish
RUNMESH_SHUTDOWN_GRACE=10s
# 2. let in-flight steps finish; after this they are RELEASED back to QUEUED
#    with their retry budget untouched — a deploy must cost zero retries
RUNMESH_DRAIN_TIMEOUT=30s
# 3. the backstop. Must exceed SHUTDOWN_GRACE + DRAIN_TIMEOUT, or it would
#    abort a shutdown that was going to succeed
RUNMESH_HARD_EXIT_AFTER=60s

# ─── Engine ──────────────────────────────────────────────────────────────────
# Names this process in the leases it takes. Defaults to hostname-pid.
# RUNMESH_OWNER=

RUNMESH_WORKERS=8
# How many steps to claim per round trip. Defaults to RUNMESH_WORKERS; it can
# never exceed it, because the dispatcher only claims what it has capacity for.
# RUNMESH_CLAIM_BATCH=

# The backstop for the store's wake-up hint. Losing a hint costs one tick of
# latency; it can never strand a job.
RUNMESH_POLL_INTERVAL=250ms

# A lease is the capability a worker holds over one step. If it expires, the
# reconciler assumes that worker died and reclaims the step.
RUNMESH_LEASE_TTL=30s
# Must leave at least three beats per lease, so two can be lost to a slow store
# or a GC pause without expiring a lease under a step that is running fine.
RUNMESH_HEARTBEAT_INTERVAL=5s
# How long a single store call may take. Must be shorter than the drain it is
# part of.
RUNMESH_STORE_TIMEOUT=5s
# How long to wait for a tool that is ignoring its cancellation before settling
# the step without it. Must be shorter than the lease it is protecting.
RUNMESH_ABANDON_GRACE=10s

# The crash-recovery sweep.
RUNMESH_RECONCILE_INTERVAL=10s
RUNMESH_RECONCILE_BATCH=100

# ─── Retry ───────────────────────────────────────────────────────────────────
# delay = BASE * FACTOR^failures, capped at MAX, then reduced by up to JITTER.
# Jitter only ever subtracts, so MAX is a real ceiling rather than an average.
RUNMESH_BACKOFF_BASE=1s
RUNMESH_BACKOFF_MAX=60s
RUNMESH_BACKOFF_FACTOR=2.0
RUNMESH_BACKOFF_JITTER=0.2

# ─── Admission control and plan limits ───────────────────────────────────────
# Submissions past this depth are refused with 429 rather than accepted into a
# queue that will never drain.
RUNMESH_MAX_QUEUE_DEPTH=10000

RUNMESH_MAX_STEPS=100
RUNMESH_MAX_DEPENDS_ON=32
RUNMESH_MAX_PARAMS_BYTES=65536
RUNMESH_MAX_STEP_TIMEOUT=15m
RUNMESH_MAX_ATTEMPTS_LIMIT=10
RUNMESH_MAX_RESULT_BYTES=262144

# Defaults applied to a step that does not specify its own.
RUNMESH_STEP_TIMEOUT=30s
RUNMESH_MAX_ATTEMPTS=3

# ─── Store ───────────────────────────────────────────────────────────────────
# The ONLY thing that selects the store. Empty means the in-memory store, which
# is a development convenience and not a deployment option: a restart loses
# every job, GET /ready reports "durable": false, and the server says so at boot.
#
# A URL that is set but unreachable FAILS the boot. It never falls back to the
# in-memory store — silently starting non-durable is how an outage becomes data
# loss.
#
#   docker compose up -d
#   RUNMESH_DATABASE_URL=postgres://runmesh:runmesh@127.0.0.1:5432/runmesh?sslmode=disable
RUNMESH_DATABASE_URL=

# Migrations are embedded in the binary and applied at boot under an advisory
# lock, so a rolling deploy of five replicas runs them exactly once. Turn this
# off to run them as a separate deployment step instead.
RUNMESH_MIGRATE_ON_BOOT=true

# Defaults to RUNMESH_WORKERS + 4, and may not be set lower. Every worker can be
# holding a connection to settle its outcome while the dispatcher, the
# reconciler and a readiness probe still need one; a pool sized to the worker
# count alone can deadlock its own drain.
# RUNMESH_DB_MAX_OPEN_CONNS=
# RUNMESH_DB_MAX_IDLE_CONNS=
RUNMESH_DB_CONN_MAX_LIFETIME=30m
RUNMESH_DB_CONN_MAX_IDLE_TIME=5m
RUNMESH_DB_CONNECT_TIMEOUT=10s

# In-memory store only: the timeline has to be bounded, or a long-running job is
# a memory leak. Exceeding a ring marks the page `truncated` rather than failing
# the job. PostgreSQL has no such limit and ignores both.
RUNMESH_JOB_EVENT_BUFFER=512
RUNMESH_GLOBAL_EVENT_BUFFER=8192

# ─── Executor ────────────────────────────────────────────────────────────────
# Where steps run: `local` (in this process) or `kubernetes` (one Job per
# attempt). This is the seam declared in Week 1 as tools.Executor — nothing in
# the dispatcher, worker pool, lease handling or state machine differs between
# them.
RUNMESH_EXECUTOR=local

# Everything below is read only when RUNMESH_EXECUTOR=kubernetes.
#
# The namespace holds task workloads ONLY, and is the single namespace the
# least-privilege Role is scoped to. RunMesh's own control plane lives
# elsewhere, so a compromised RunMesh cannot reach its own Deployment.
RUNMESH_K8S_NAMESPACE=runmesh-tasks

# The image a tool runs when its descriptor names none. Required in kubernetes
# mode: a tool with no image has nothing to run.
#   docker build -f deploy/docker/task.Dockerfile -t runmesh/task:dev .
#   kind load docker-image runmesh/task:dev --name runmesh
RUNMESH_K8S_IMAGE=runmesh/task:dev

# The identity task pods run as. It holds no Role anywhere, and the Job spec
# also sets automountServiceAccountToken: false — two independent reasons an
# untrusted workload cannot reach the API server.
RUNMESH_K8S_TASK_SERVICE_ACCOUNT=runmesh-task

# Empty means in-cluster credentials when running as a pod, falling back to the
# usual kubeconfig for development. Set either to be explicit.
# RUNMESH_K8S_KUBECONFIG=
# RUNMESH_K8S_CONTEXT=kind-runmesh

# ttlSecondsAfterFinished on every Job. This is the cleanup that survives
# RunMesh dying — precisely when nobody is around to notice leaked workloads.
RUNMESH_K8S_TTL_AFTER_FINISHED=5m

# Added to the step timeout to form the Job's activeDeadlineSeconds, which is a
# BACKSTOP rather than the timeout. RunMesh's own deadline must fire first and
# produce a classified TIMED_OUT; if Kubernetes won that race it would replace
# it with an opaque DeadlineExceeded, so the two must never be equal.
RUNMESH_K8S_DEADLINE_GRACE=1m

# How often a Job's status is read. Polling rather than watching is deliberate
# — see internal/k8s/executor.go — and the worst case of a slow interval is
# added latency, never a missed completion.
RUNMESH_K8S_POLL_INTERVAL=500ms

# Bounds the deletes that run after an attempt's context has already been
# cancelled. Must be shorter than the drain it is part of.
RUNMESH_K8S_CLEANUP_TIMEOUT=15s

# The uid/gid task containers run as. These parameterise the pod security
# context; they do NOT switch it off. runAsNonRoot, readOnlyRootFilesystem,
# capabilities: drop [ALL], allowPrivilegeEscalation: false and seccomp
# RuntimeDefault are properties of the spec builder and have no variable,
# because a security control an operator can disable with an environment
# variable is a security control that will be disabled with one.
#
# 65532 is distroless' "nonroot" uid, which every shipped image already uses.
# Zero is refused at boot: runAsNonRoot with uid 0 is rejected at admission,
# for every pod, and finding that out one pod at a time is expensive.
RUNMESH_K8S_RUN_AS_USER=65532
RUNMESH_K8S_RUN_AS_GROUP=65532

# How long a task pod gets between SIGTERM and SIGKILL. Short, because a pod is
# deleted exactly when RunMesh has decided the step should stop.
RUNMESH_K8S_TERMINATION_GRACE=5s

# ─── Execution policy ────────────────────────────────────────────────────────
# The operator's ceiling on what any tool may have. A tool descriptor ASKS; this
# GRANTS. Resources clamp silently — a portable descriptor meeting a smaller
# cluster runs smaller — while capabilities refuse loudly, with a classified
# error naming the switch. See internal/policy and ADR 0010.
#
# These apply in BOTH executor modes. In `local` mode the resource numbers have
# nothing to enforce them, but the tool allowlist and the container-only gate
# still do, and the catalogue still publishes the truth.

# What a tool that declares nothing gets. An unset limit in Kubernetes is not a
# small share — it is as much as the node has — so there is no "unlimited"
# spelling here that is not a deliberate empty string.
RUNMESH_POLICY_DEFAULT_CPU=250m
RUNMESH_POLICY_DEFAULT_MEMORY=128Mi
RUNMESH_POLICY_DEFAULT_EPHEMERAL_STORAGE=64Mi

# The ceiling a tool cannot exceed however much it asks for. Empty means no
# ceiling, which is defensible on a single-tenant development cluster and
# nowhere else. ephemeral-storage is the dimension that takes a NODE down rather
# than a pod: container logs count towards it, so a task looping on print()
# fills the node's disk and evicts everything scheduled there.
RUNMESH_POLICY_MAX_CPU=1
RUNMESH_POLICY_MAX_MEMORY=512Mi
RUNMESH_POLICY_MAX_EPHEMERAL_STORAGE=512Mi

# The master switch for egress. False denies the network to every tool whatever
# its descriptor says, so turning the feature off is one variable rather than an
# audit of every descriptor. A tool that asks for the network while this is
# false is REFUSED, not silently downgraded — running it without the network
# produces a connection timeout that reads like the remote host's fault.
#
# When true, the pods of network tools are labelled runmesh.io/network=allow and
# the NetworkPolicy in deploy/kubernetes lets them reach public addresses only.
# That policy is enforced by the CNI or not at all: run
# ./deploy/kind/verify-networkpolicy.sh before trusting it.
RUNMESH_POLICY_ALLOW_NETWORK=false

# Tool gating. ALLOW, if set, is exact: only these names run, whatever the
# registry contains. DENY always wins over it. Both exist because they answer
# different questions — an allowlist is the posture, a denylist is the incident
# response you reach for without redeploying a registry. Empty ALLOW means
# every registered tool, because an unset variable must not stop the fleet.
# RUNMESH_POLICY_TOOLS_ALLOW=echo,sleep,python_execute
# RUNMESH_POLICY_TOOLS_DENY=

# Constrains which images a tool may name. Descriptors are compiled in today so
# this guards a smaller hole than it looks, but it costs one string compare and
# the descriptor list is exactly the kind of thing that grows a config file.
# RUNMESH_POLICY_IMAGE_PREFIXES=runmesh/,ghcr.io/kalanas210/

# ─── Tools ───────────────────────────────────────────────────────────────────
# Registers the `fail` tool, whose entire purpose is to panic, hang and fail on
# demand. Off by default; a production deployment must not expose it.
RUNMESH_ENABLE_TEST_TOOLS=false
RUNMESH_MAX_OUTPUT_BYTES=65536

# The image implementing the container tool contract for the Go tools. Defaults
# to RUNMESH_K8S_IMAGE, so a single-image deployment sets one variable.
# RUNMESH_TASK_IMAGE=runmesh/task:dev

# The Python sandbox image. EMPTY MEANS python_execute IS NOT REGISTERED, which
# is the honest answer: a tool that passes plan validation and then fails every
# attempt for want of an image is worse than one that is plainly absent, where
# the 400 says unknown_tool and lists what is available.
#
#   docker build -f deploy/docker/python.Dockerfile -t runmesh/python:dev .
#   kind load docker-image runmesh/python:dev --name runmesh
#
# The interpreter is NOT the sandbox — the pod is. See ADR 0009 before assuming
# anything about what the step's code can and cannot do.
# RUNMESH_PYTHON_IMAGE=runmesh/python:dev

# ─── Logging ─────────────────────────────────────────────────────────────────
# debug | info | warn | error
RUNMESH_LOG_LEVEL=info
# json | text  (text is easier to read locally; json is what you want shipped)
RUNMESH_LOG_FORMAT=json
