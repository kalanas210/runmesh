# The RunMesh console's own environment. Copy to web/.env.local.
#
# THIS IS NOT THE REPOSITORY'S TOP-LEVEL .env.example. That one documents
# internal/config's loader and asserts a one-to-one correspondence with it.
# This file documents two variables that internal/config does not read at all.
# It lives here, in web/, and the two files must never be merged.
#
# (The name is forced: the repository .gitignore ignores `.env.*` and un-ignores
# only the exact name `.env.example`, so a file called `.env.local.example`
# would be silently untracked and nobody would ever receive it.)
#
# BOTH of these are read by Node — by the route handler at
# app/api/rm/[...path]/route.ts — and by nothing else. Neither is prefixed
# NEXT_PUBLIC_, so neither reaches the browser bundle. That is the entire
# security model of this app: the API key lives on the server, the browser
# talks only to /api/rm, and the Go API never sees a cross-origin request.
#
# They must NOT be added to the repository's top-level .env.example. That file
# asserts a one-to-one correspondence with internal/config's loader, maintained
# by discipline rather than by a test, and internal/config does not read either
# of these. Adding them would make the file's own header comment false.

# Where the Go API is listening. RUNMESH_HTTP_ADDR defaults to :8080.
RUNMESH_API_URL=http://127.0.0.1:8080

# An API key carrying at least the jobs.read scope. Everything the console
# reads — the job list, a job, its events, the tool catalogue — needs it;
# submitting needs jobs.write and the cancel button needs jobs.cancel.
RUNMESH_API_KEY=
