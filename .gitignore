# Binaries
bin/
dist/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test & coverage
*.test
*.out
coverage
coverage.html

# Go workspace
go.work
go.work.sum

# Env / secrets
.env
.env.*
!.env.example

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Node (web/)
node_modules/
.next/
out/
# TypeScript incremental build state, and the type shim next build regenerates
# on every run: it imports route types from .next/, which is ignored, so a
# committed copy would not resolve on a clean checkout.
*.tsbuildinfo
next-env.d.ts

# Local assistant / editor state — machine-local, never committed
.claude/
.claude*/
CLAUDE.md
CLAUDE.local.md
.mcp.json
.cursor/
.cursorrules
.aider*
.continue/
.windsurf/
.github-copilot/
.anthropic/
.codeium/

# Agent transcripts, session logs and scratch output
*.session.json
*.transcript
*.transcript.jsonl
transcripts/
scratchpad/
.scratch/

# The Prometheus scrape credential. deploy/prometheus/scrape-token.example is
# tracked and holds a throwaway key so a clean clone comes up working; this is
# the path an operator naturally drops a REAL key into, so it is ignored rather
# than left as a tracked file somebody edits in place and commits.
deploy/prometheus/scrape-token
